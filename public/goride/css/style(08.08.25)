    color: #fff;
}
.navbar .navbar-nav .nav-link {
    font-family: 'Outfit', sans-serif;
    font-size: 14px;
    font-weight: 300;
    color: #fff;
    margin: 1px;
    -webkit-transition: all .4s;
    transition: all .4s;
    padding-right: 9px;
    padding-left: 9px;
