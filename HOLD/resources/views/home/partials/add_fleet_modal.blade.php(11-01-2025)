.modal-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 7px 10px 11px 10px;
    border-bottom: 1px solid #e9ecef;
    border-top-left-radius: 0.3rem;
    border-top-right-radius: 0.3rem;
