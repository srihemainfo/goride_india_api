<script>
    $(document).ready(function() {

        showlist();
        $('#car-faremodel').modal('show')

    });

    $(document).on('input', '.editable-input', function() {

        validateInputInteger(this);

    });

    function validateInputInteger(input) {

        input.value = input.value

            .replace(/[^0-9.]/g, '')

            .replace(/(\..*)\./g, '$1');

    }
</script>

<script>
    let timeout;

    var currentvalue = 2;

    $(document).ready(function() {

        $.ajaxSetup({

            headers: {
                'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')
            }
        });

        function formData(formrow) {
            var allRowData = [];

            $('#' + formrow + ' tr').each(function() {
                var rowData = {};
                $(this).find('input').each(function() {

                    var inputName = $(this).attr('name');
                    var inputValue = $(this).val();
                    if (inputValue === '') {

                        inputValue = '0';
                    }
                    rowData[inputName.slice(0, -2)] = inputValue;
                });
                allRowData.push(rowData);
            });

            return allRowData;
        }
        showlist();
        $('#update-all-btn').on('click', function(e) {
            e.preventDefault();
            var allRowData = finalRowData = [];
            allRowData = formData('table-body');
            finalRowData = formData('table-second-body')
            var combinedData = allRowData.concat(finalRowData);
            let updates = [];
            formDataObject['data'] = combinedData;
            $.ajax({
                url: '{{env('API_URL')}}updatedynamicfareoverall',
                method: 'POST',
                data: formDataObject,
                success: function(response) {
                    var message = response.message;
                    var status = response.status;
                    if (status == 200) {
                        swalalertsuccess(message);
                        showlist();
                    } else {
                        swalalerterror(message);

                    }
                    let curr_url = window.location.pathname;
                    if (curr_url == '/create-carfares') {
                        window.location.href = '/booking/create';
                    } else {
                        window.location.reload();
                    }
                },
                error: function(xhr, status, error) {
                    alert('Failed to update data.');
                }
            });
        });
    });
    // Ajax for Save and Update
    $('.updateFare').click(function(e) {
        e.preventDefault();
        let id = $(this).data("id");
        $.ajax({
            data: $('#car_fare_' + id).serialize(),
            url: "{{ route('carfare.store') }}",
            type: "POST",
            dataType: 'json',
            success: function(response) {
                if (response.isUpdated) {
                    Swal.fire({
                        position: 'top-end',
                        icon: 'success',
                        title: 'Car Fare',
                        text: 'Car fares updated successfully',
                        showConfirmButton: false,
                        timer: 2000,
                    }).then((willUpdate) => {
                        if (willUpdate.isConfirmed) {
                            location.reload();
                        }
                    })
                } else {
                    Swal.fire("Error", "Carfare not updated", "error");
                }
            },
            error: function(data) {}

        });

    });

function showlist() {
    var formDataObject = {};
    formDataObject['token'] = getCookie('d_token');
    formDataObject['device_id'] = 0;

    $.ajax({
        url: '{{env('API_URL')}}dynamiccarfare',
        method: 'POST',
        data: formDataObject,
        success: function(response) {
            $('#header_container, #table-body').empty();

            if (response.data) {
                // Update table header and body
                if (response.data.head) {
                    $('#header_container').html(response.data.head);
                }

                if (response.data.firsttbody) {
                    $('#table-body').html(response.data.firsttbody);
                }

                var currentvalue = response.data.start_value;
                var final_value = response.data.final_value;

                // Set initial start value
                $('#start').val(final_value);

                // Event handler for adding a new row
                $(document).off('click', '.addButton').on('click', '.addButton', function(e) {
                    e.preventDefault();

                    var currentRow = $(this).closest('tr');
                    var startVal = parseFloat(currentRow.find('input[name="start[]"]').val());
                    var endVal = parseFloat(currentRow.find('input[name="end[]"]').val());
                    
                    console.log(startVal);
                    console.log(endVal);

                    // Validate end value - ensure start < end
                    if (startVal >= endVal) {
                        swalalert('Start value must be less than End value');
                        return;
                    }

                    // Get car names from response
                    var carNames = response.data.carName;

                    // Generate new row with next start value (based on previous row's end value)
                    var nextStartValue = endVal;

                    var newRow = `<tr class='dynamicRow'>
                        <td>
                            <span class='start-value'>${nextStartValue}</span>
                            <input type='hidden' name='start[]' value='${nextStartValue}' class='form-control'>
                        </td>
                        <td>
                            <input type='text' name='end[]' value='' oninput='validateInputInteger(this)' class='form-control'>
                        </td>`;

                    // Append car name inputs for the new row
                    for (let key in carNames) {
                        if (carNames.hasOwnProperty(key)) {
                            var carName = carNames[key];
                            newRow += `<td>
                                <input type='text' class='form-control editable-input' name='${carName}[]' value='0' data-column='${carName}' oninput='validateInputInteger(this)'>
                            </td>`;
                        }
                    }

                    // Add the Remove button for the new row (unless it's the first row)
                    if ($('.dynamicRow').length > 0) {
                        newRow += `<td><button class='btn btn-danger removeButton'>-</button></td>`;
                    } else {
                        newRow += `<td></td>`; // For the first row, no remove button.
                    }

                    newRow += `</tr>`;

                    // Append the new row below the current row
                    currentRow.after(newRow);

                    // Reset the end input for next use
                    currentRow.find('input[name="end[]"]').val('');

                    // Optionally, update the start field for the next row in case of continuous input
                    console.log(nextStartValue);
                    $('#start').val(nextStartValue);

                    // Check if the newly created row is the last one
                    updateLastRow();
                });

                // Event handler for removing a row
                $(document).off('click', '.removeButton').on('click', '.removeButton', function() {
                    var closestTr = $(this).closest('tr');
                    var prevRow = closestTr.prev('tr');
                    var nextRow = closestTr.next('tr');

                    // Update the next row's start value to the current row's end value
                    if (nextRow.length) {
                        var currentEndValue = parseFloat(closestTr.find('input[name="end[]"]').val());
                        nextRow.find('input[name="start[]"]').val(currentEndValue);
                        nextRow.find('span.start-value').text(currentEndValue);
                    }

                    // Remove the current row
                    closestTr.remove();

                    // After removing, check if last row needs to be updated
                    updateLastRow();
                });

                // Function to handle last row behavior (only plus button, no remove)
                function updateLastRow() {
                    var lastRow = $('#table-body tr.dynamicRow').last();

                    if (lastRow.length) {
                        var lastRowEndInput = lastRow.find("input[name='end[]']");
                        lastRow.find("td:last-child").html('<button class="btn btn-success addButton">+</button>'); // Add the + button

                        // Ensure the last row's end value doesn't exceed previous row's end value
                        lastRowEndInput.on('input', function () {
                            var lastEndValue = parseInt(lastRowEndInput.val());
                            var previousRowEndValue = parseInt(lastRow.prev('tr').find("input[name='end[]']").val());

                            if (lastEndValue <= previousRowEndValue) {
                                lastRow.find('input[name="end[]"]').val(lastEndValue); // Fix end value if validation fails
                            }
                        });
                    }
                }
            }
        },
        error: function(error) {
            console.error('Error fetching data:', error);
        }
    });
}






</script>
