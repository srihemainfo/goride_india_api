<div class="modal fade" id="createJobModal" tabindex="-1" aria-labelledby="createJobLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content p-3">
      <div class="modal-header d-flex justify-content-center position-relative">
        <h5 class="modal-title" id="createJobLabel">Create Job</h5>
        <button type="button" class="btn-close position-absolute end-0 me-3" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body p-3">
        <form id="journeyForm">

          <!-- Journey Type -->
          <div class="mb-2 d-flex align-items-center">
            <label class="form-label me-3 mb-0">Journey Type:</label>
            <div class="form-check me-3">
              <input class="form-check-input" type="radio" name="tripType" id="oneWay" value="oneway" checked>
              <label class="form-check-label" for="oneWay">One Way</label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="tripType" id="roundTrip" value="roundtrip">
              <label class="form-check-label" for="roundTrip">Round Trip</label>
            </div>
          </div>

          <!-- From, To, Distance -->
          <div class="row mb-2">
            <div class="col-md-4">
              <input type="text" id="fromPlace" class="form-control p-2" placeholder="From">
            </div>
            <div class="col-md-4">
              <input type="text" id="toPlace" class="form-control p-2" placeholder="To">
            </div>
            <div class="col-md-4">
              <input type="number" id="distance" class="form-control p-2" placeholder="Distance (km)" readonly>
            </div>
          </div>

          <!-- Pickup, Drop, Passenger -->
          <div class="row mb-2">
            <div class="col-md-4">
              <label>Pickup Date & Time</label>
              <input type="datetime-local" id="pickupDate" class="form-control p-2">
            </div>
            <div class="col-md-4 d-none" id="dropSection">
              <label>Drop Date & Time</label>
              <input type="datetime-local" id="dropDate" class="form-control p-2">
            </div>
            <div class="col-md-4">
              <label>Passenger Count</label>
              <select id="passengerCount" class="form-select p-2">
                <option value="">Select</option>
                <script>
                  for (let i = 1; i <= 54; i++) {
                    document.write(`<option value="${i}">${i}</option>`);
                  }
                </script>
              </select>
            </div>
          </div>

          <!-- Additional Charges -->
          <div class="mb-2">
            <label class="form-label fw-bold">Additional Charges (₹)</label>
            <div class="row">
              <div class="col-md-4">
                <input type="number" class="form-control p-2" id="bata" placeholder="Bata">
              </div>
              <div class="col-md-4">
                <input type="number" class="form-control p-2" id="toll" placeholder="Toll">
              </div>
              <div class="col-md-4">
                <input type="number" class="form-control p-2" id="parking" placeholder="Parking">
              </div>
            </div>
          </div>

          <!-- Expiry and Amounts -->
          <div class="row">
            
            
            <div class="col-8">
  <label>Expected Amount (₹)</label>
  <input type="text" id="marketedPrice" class="form-control p-2">
  <small class="form-text text-muted mt-1">The expected marketed price is ₹500.</small>
</div>

            <div class="col-4">
              <label>Expiry Date &amp; Time</label>
              <input type="datetime-local" id="expiryDate" class="form-control p-2">
            </div>
