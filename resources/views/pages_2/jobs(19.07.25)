 const ratePerKm = {
    4: 12,
    8: 20,
    12: 30
  };

  const extraCharges = {
    batta: 300,
    toll: 200,
    parking: 150,
    night: 400
  };

  const calculateAmount = () => {
    const distance = parseFloat(document.getElementById("distance").value);
    const vehicle = document.getElementById("vehicleType").value;
    if (!distance || !vehicle) return;

    let base = distance * ratePerKm[vehicle];

    if (document.getElementById("batta").checked) base += extraCharges.batta;
    if (document.getElementById("toll").checked) base += extraCharges.toll;
    if (document.getElementById("parking").checked) base += extraCharges.parking;
    if (document.getElementById("night").checked) base += extraCharges.night;

    document.getElementById("amount").value = base;
  };

  ["distance", "vehicleType", "batta", "toll", "parking", "night"].forEach(id => {
    document.getElementById(id).addEventListener("input", calculateAmount);
    document.getElementById(id).addEventListener("change", calculateAmount);
  });

 
 
  
